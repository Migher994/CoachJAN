# Anthropic API key for the two coach features. Server side only, never shipped to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection string, e.g. postgresql://coachjan:coachjan@localhost:5432/coachjan
# In production against Cloud SQL, use a unix-socket string instead - see DEPLOY.md.
DATABASE_URL=postgresql://coachjan:coachjan@localhost:5432/coachjan

# Set to true only for a TCP connection to a database that requires TLS.
# Leave false (or unset) for local Postgres and for Cloud SQL's unix socket.
PGSSL=false

# Signs session cookies. Any long random string; generate one with
# `openssl rand -base64 48`. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: name of a Cloud Storage bucket to store uploaded FIT files in.
# Leave unset in development to store them under ./uploads instead.
GCS_BUCKET=

# Optional overrides
PORT=5174
